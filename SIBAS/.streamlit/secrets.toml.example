# Streamlit Secrets Template
# For LOCAL development: Copy this file to secrets.toml and fill in your values
# For STREAMLIT CLOUD: Add these secrets via the Secrets panel in your app settings

DB_NAME = "your_database_name"
DB_USER = "your_database_user"
DB_PASSWORD = "your_secure_password"
DB_HOST = "your_database_host.example.com"
DB_PORT = "5432"
